<UserControl x:Class="Uproot.LeftoverPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Uproot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="List"
                  BorderThickness="0" Background="Transparent"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  KeyDown="List_KeyDown"
                  MouseDoubleClick="List_MouseDoubleClick"
                  Padding="12,0,12,8">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="6,16,0,6" FontWeight="SemiBold">
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='  {0}'}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Показать в проводнике" Click="ShowItem_Click" />
                                <MenuItem Header="Скопировать путь" Click="CopyPath_Click" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type local:Leftover}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect, Mode=OneTime}"
                                  VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" Focusable="False" />
                        <TextBlock Grid.Column="1" Text="{Binding Glyph, Mode=OneTime}" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" VerticalAlignment="Center" Margin="2,0,14,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Location, Mode=OneTime}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Location, Mode=OneTime}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Badge, Mode=OneTime}" FontFamily="{StaticResource IconFont}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="Системный или общий путь — Uproot его не трогает" />
                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" MinWidth="84" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Пустое состояние и индикатор поиска -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock x:Name="EmptyGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="40"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Нижняя панель -->
        <!-- Отступ 24 — как у шапки, карточки шагов и строки поиска -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="24,10"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <DockPanel LastChildFill="True">
                <Button x:Name="SelectAllButton" Content="Выбрать все" Click="SelectAll_Click" DockPanel.Dock="Left" />
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Click="Delete_Click" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Удалить выбранное" />
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Margin="0,0,16,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="Summary" Margin="16,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
