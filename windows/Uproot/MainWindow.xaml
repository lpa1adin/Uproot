<Window x:Class="Uproot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Uproot"
        Title="Uproot" Width="1160" Height="740" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- ============ Навигация ============ -->
        <DockPanel Margin="8,8,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,6,0,20">
                <Image Source="AppIcon.ico" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock Text="Uproot" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBoxItem Tag="apps" IsSelected="True" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Программы" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="orphans" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Остатки удалённых" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="search" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Поиск файлов" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="settings" Padding="12,9" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ============ Контент ============ -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>

                <!-- ===== Программы ===== -->
                <Grid x:Name="AppsPage">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="16,16,12,8">
                            <Grid>
                                <TextBox x:Name="AppFilter" TextChanged="AppFilter_TextChanged" Padding="34,6,8,6" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="AppFilterHint" Text="Найти программу" Margin="36,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <DockPanel Margin="2,10,0,0">
                                <ComboBox x:Name="AppSort" DockPanel.Dock="Right" SelectedIndex="0" SelectionChanged="AppSort_SelectionChanged" MinWidth="130">
                                    <ComboBoxItem Content="По имени" />
                                    <ComboBoxItem Content="По размеру" />
                                </ComboBox>
                                <TextBlock x:Name="AppCount" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                        </StackPanel>
                        <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged" BorderThickness="0" Background="Transparent"
                                 Padding="8,0,8,8" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="10,7" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:InstalledApp}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding Icon, Mode=OneTime}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle, Mode=OneTime}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneTime}" Margin="10,0,0,0" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- Подробности -->
                    <Grid Grid.Column="2">
                        <StackPanel x:Name="NoSelection" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Выберите программу" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Uproot покажет все её файлы и записи реестра." />
                        </StackPanel>

                        <Grid x:Name="Detail" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Grid Margin="24,20,24,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image x:Name="DetailIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailSub" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DetailPath" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Шаги -->
                            <Border Grid.Row="1" Margin="24,0,24,8" Padding="16,12" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="RescanButton" Click="Rescan_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Искать снова" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="UninstallButton" Click="Uninstall_Click" Style="{DynamicResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Запустить деинсталлятор" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="StepTitle" FontWeight="SemiBold" Text="Шаг 1 — штатное удаление" />
                                        <TextBlock x:Name="StepText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Затем Uproot найдёт оставшиеся файлы." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <local:LeftoverPanel x:Name="AppPanel" Grid.Row="2" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Остатки удалённых ===== -->
                <DockPanel x:Name="OrphansPage" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                        <Button DockPanel.Dock="Right" Click="OrphansScan_Click" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Проверить снова" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Остатки удалённых программ" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Файлы и записи программ, которых больше нет." />
                        </StackPanel>
                    </DockPanel>
                    <local:LeftoverPanel x:Name="OrphansPanel" />
                </DockPanel>

                <!-- ===== Поиск ===== -->
                <DockPanel x:Name="SearchPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                        <TextBlock Text="Поиск файлов и папок" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <DockPanel>
                            <Button x:Name="SearchButton" DockPanel.Dock="Right" Click="Search_Click" Margin="8,0,0,0" MinWidth="100"
                                    IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Content="Искать" />
                            <ComboBox x:Name="SearchScope" DockPanel.Dock="Right" SelectedIndex="1" Margin="8,0,0,0" MinWidth="200">
                                <ComboBoxItem Content="Папка пользователя" />
                                <ComboBoxItem Content="Программы и AppData" />
                                <ComboBoxItem Content="Все локальные диски" />
                            </ComboBox>
                            <Grid>
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="34,6,8,6" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SearchHint" Text="Часть имени: например, zoom, telegram, adobe" Margin="36,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DockPanel>
                        <CheckBox x:Name="SearchRegistry" Content="Искать и в реестре (HKCU\Software, HKLM\SOFTWARE)" IsChecked="True" Margin="0,10,0,0" />
                    </StackPanel>
                    <local:LeftoverPanel x:Name="SearchPanel" />
                </DockPanel>

                <!-- ===== Настройки ===== -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

                        <Border Padding="16" CornerRadius="6" BorderThickness="1" Margin="0,0,0,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="170" VerticalAlignment="Center"
                                          SelectionChanged="ThemeBox_SelectionChanged">
                                    <ComboBoxItem Content="Как в Windows" Tag="System" />
                                    <ComboBoxItem Content="Светлая" Tag="Light" />
                                    <ComboBoxItem Content="Тёмная" Tag="Dark" />
                                </ComboBox>
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Тема оформления" />
                                    <TextBlock Text="Светлая, тёмная или как в параметрах Windows" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Padding="16" CornerRadius="6" BorderThickness="1" Margin="0,0,0,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Открыть папку" Click="OpenBackups_Click" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Резервные копии реестра" />
                                    <TextBlock x:Name="BackupPathText" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Padding="16" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Права администратора" />
                                    <TextBlock x:Name="AdminText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
